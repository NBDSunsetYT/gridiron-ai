# Local development defaults. Never prefix secrets with NEXT_PUBLIC_.
# Docker overrides DATA_DIR and NODE_ENV; set APP_URL to your real HTTPS origin there.
DATA_DIR=./data
APP_URL=http://localhost:3000
# Existing records remain in SQLite unless this is explicitly switched.
# Supabase can also be selected per device in Settings without resetting SQLite.
DATA_BACKEND=sqlite
# Enable on hosted ephemeral containers to prevent selection of a temporary ledger.
# Local legacy records remain preserved in their original DATA_DIR.
GRIDIRON_CLOUD_ONLY=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only random encryption key for registered native device tokens.
DEVICE_TOKEN_ENCRYPTION_KEY=
# Actual hosted HTTPS app origin for native preparation; no placeholder accepted.
GRIDIRON_NATIVE_URL=
GRIDIRON_IOS_BUNDLE_ID=ai.gridiron.personal
# Optional licensed sportsbook feed; availability depends on entitlement.
ODDS_API_KEY=
# Optional server-side conversational assistant. Billable usage applies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional private Python quantitative service. Compose uses http://quant:8000.
SIMULATION_SERVICE_URL=http://127.0.0.1:8000
# Generate a random token of at least 32 characters; same value in both services.
SIMULATION_SERVICE_TOKEN=
# Operator cron authorization, separate from the simulation token (at least32 chars).
CRON_SECRET=

# Hosted Vercel transport: compact owned model references and durable async jobs.
GRIDIRON_COMPACT_API=false
GRIDIRON_ASYNC_SIMULATIONS=false

# Optional Vercel Gateway; never enable generation solely from a positive balance.
AI_PROVIDER=openai
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
AI_GATEWAY_INCLUDED_CREDITS_ALLOWED=0
AI_GATEWAY_API_KEY=

# Server-only shared NFL ingestion capability; configure on the host, never in browser code.
GRIDIRON_PUBLIC_INGEST_TOKEN=
