# Local development defaults. Never prefix secrets with NEXT_PUBLIC_.
# Docker overrides DATA_DIR and NODE_ENV; set APP_URL to your real HTTPS origin there.
DATA_DIR=./data
APP_URL=http://localhost:3000
# Existing records remain in SQLite unless this is explicitly switched.
# Supabase can also be selected per device in Settings without resetting SQLite.
DATA_BACKEND=sqlite
# Enable on hosted ephemeral containers to prevent selection of a temporary ledger.
# Local legacy records remain preserved in their original DATA_DIR.
GRIDIRON_CLOUD_ONLY=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only random encryption key for registered native device tokens.
DEVICE_TOKEN_ENCRYPTION_KEY=
# Actual hosted HTTPS app origin for native preparation; no placeholder accepted.
GRIDIRON_NATIVE_URL=
GRIDIRON_IOS_BUNDLE_ID=ai.gridiron.personal
# Optional licensed sportsbook feed; availability depends on entitlement.
ODDS_API_KEY=
# Optional server-side conversational assistant. Billable usage applies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional private Python quantitative service. Compose uses http://quant:8000.
SIMULATION_SERVICE_URL=http://127.0.0.1:8000
# Generate a random token of at least 32 characters; same value in both services.
SIMULATION_SERVICE_TOKEN=
# Operator cron authorization, separate from the simulation token (at least32 chars).
CRON_SECRET=

# Hosted Vercel transport: compact owned model references and durable async jobs.
GRIDIRON_COMPACT_API=false
GRIDIRON_ASYNC_SIMULATIONS=false

# Optional Vercel Gateway; never enable generation solely from a positive balance.
AI_PROVIDER=openai
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
AI_GATEWAY_INCLUDED_CREDITS_ALLOWED=0
AI_GATEWAY_API_KEY=

# Server-only shared NFL ingestion capability; configure on the host, never in browser code.
GRIDIRON_PUBLIC_INGEST_TOKEN=

# Optional authorized DraftKings Predictions EVENT-CONTRACT partner feed.
# This does not create a license or authorize restricted/private API access.
GRIDIRON_DK_PREDICTIONS_FEED_URL=
GRIDIRON_DK_PREDICTIONS_FEED_TOKEN=
GRIDIRON_DK_PREDICTIONS_FEED_AUTHORIZED=0
# Optional operator rollback map: {"category|modelVersion":"approvedArtifactId"}.
# Leave empty to use validated defaults; null disables calibration for a scope.
GRIDIRON_PROP_CALIBRATOR_SELECTION=

# Vercel/server-only link to an optional Render licensed-data gateway.
# Leave blank until a real Render service exists and its bridge is verified.
# BALLDONTLIE_API_KEY and optional CFBD_API_KEY belong ONLY in that Render
# service's Environment: never in this file, .env.local, Vercel, browser or Git.
GRIDIRON_RENDER_DATA_URL=
GRIDIRON_DATA_BRIDGE_TOKEN=

# Primary9.0 sportsbook feed: PROPLINE_API_KEY is configured ONLY in Render.
# Do not put the provider credential in local/Vercel/client environment files.

# v11 server-only storage. Keep disabled until actual authorized read/write tests pass.
GRIDIRON_MONGODB_RESEARCH=0
MONGODB_URI=
MONGODB_DATABASE=gridiron_research
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Read authorization for verifying managed/custom public access is disabled.
CLOUDFLARE_R2_ADMIN_TOKEN=
GRIDIRON_ARCHIVE_MODEL_ARTIFACTS=0
# Verified app-user UUID allowlist; never grant administration via user_metadata.
GRIDIRON_STORAGE_ADMIN_USER_IDS=
# Optional verified unit prices; blank means estimated cost is unavailable.
R2_STORAGE_USD_PER_GB_MONTH=
MONGODB_STORAGE_USD_PER_GB_MONTH=
MONGODB_STORAGE_LIMIT_BYTES=
R2_STORAGE_WARNING_BYTES=

# Set 0 only to roll back automatic public prop research; history is preserved.
GRIDIRON_AUTO_PROPS=1

# Existing signed schedule runs the bounded GALL audit at most hourly.
# Set 0 to pause learning jobs; archived evidence remains readable.
GRIDIRON_GALL_ENABLED=1
# Only doubly validated separate home-win calibration may be promoted.
# This never promotes experimental play mechanics. Set 0 to withhold it.
GRIDIRON_GALL_PROMOTION=1

# Optional emergency compute pause; archived NBA research stays readable.
GRIDIRON_NBA_SIMULATIONS_ENABLED=1

# Local controlled worker only. Vercel always refuses model execution.
# GRIDIRON_COMPUTE_ROLE=worker
# python scripts/compute-worker.py --max-jobs 2 --cpu-seconds 300 --wall-seconds 600
