{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "installCommand": "npm ci",
      "functions": {
        "app/api/**/*.ts": {
          "maxDuration": 300
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "quant",
          "format": "url",
          "env": "SIMULATION_SERVICE_URL"
        }
      ]
    },
    "quant": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "modeling.service:app",
      "functions": {
        "modeling/service.py": {
          "maxDuration": 300,
          "excludeFiles": "{app/**,components/**,lib/**,public/**,scripts/**,supabase/**,tests/**,docs/**,node_modules/**,.next*/**,modeling/test_*.py,modeling/backtest_*.py}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
